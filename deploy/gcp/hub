#!/usr/bin/env bash
# Run a bmb-hub admin command on the hub VM from your laptop:
#   deploy/gcp/hub agent-token my-agent
#   deploy/gcp/hub enroll examples/tasks/sequence_regression    (copies the task up first; --replace
#                                                                to change an enrolled task's package)
#   deploy/gcp/hub status
#   deploy/gcp/hub deploy        (update the live hub to main's head; no reboot, ~1s pause)
#   deploy/gcp/hub deploy v0.2.0 (update it to exactly that release tag; see deploy/release.sh)
set -euo pipefail
NAME="${NAME:-bmb-hub}"; ZONE="${ZONE:-us-central1-a}"
PROJECT="${PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
run() { gcloud compute ssh "$NAME" --zone "$ZONE" --project "$PROJECT" --quiet --command "$1"; }
DOMAIN="$(gcloud compute instances describe "$NAME" --zone "$ZONE" --project "$PROJECT" --format json |
  python3 -c 'import json, sys; print(next(i["value"] for i in json.load(sys.stdin)["metadata"]["items"] if i["key"] == "domain"))')"
HUB="sudo -u bmb -H /home/bmb/bmb-eval/.venv/bin/bmb-hub --state /home/bmb/hub_state"

if [ "${1:-}" = "deploy" ]; then
  # Update the live hub without a reboot: everything slow happens while the old hub serves;
  # the restart itself is about a second, with requests held. With a tag, the hub checks out
  # exactly that release (detached, so reboots keep it); without one it follows main.
  REF="${2:-}"
  if [ -n "$REF" ]; then
    [[ "$REF" =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "not a git ref: $REF" >&2; exit 1; }
    GIT="git -C /home/bmb/bmb-eval fetch -q --tags origin && git -C /home/bmb/bmb-eval checkout -q --detach $REF"
  else
    GIT="git -C /home/bmb/bmb-eval checkout -q main && git -C /home/bmb/bmb-eval pull -q --ff-only"
  fi
  run "sudo -u bmb -H bash -c '$GIT' && sudo bash /home/bmb/bmb-eval/deploy/gcp/hub-deploy.sh"
elif [ "${1:-}" = "enroll" ]; then
  dir="${2:?usage: hub enroll <task folder> [--replace]}"
  task="$(basename "$dir")"
  shift 2
  gcloud compute scp --recurse "$dir" "$NAME:/tmp/bmb-task-$task" --zone "$ZONE" --project "$PROJECT" --quiet
  run "sudo rm -rf /home/bmb/tasks/$task && sudo mkdir -p /home/bmb/tasks && \
       sudo mv /tmp/bmb-task-$task /home/bmb/tasks/$task && sudo chown -R bmb /home/bmb/tasks && \
       $HUB enroll /home/bmb/tasks/$task --public-url https://$DOMAIN $*"
else
  run "$HUB $*"
fi
